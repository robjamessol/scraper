# Newsletter Advertiser Intelligence System - Environment Variables

# Apollo.io (sign up at apollo.io for contact enrichment)
APOLLO_API_KEY=your_key_here

# Google Cloud Service Account (for Sheets integration)
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/credentials.json
GOOGLE_SHEET_ID=your_sheet_id_here

# Gmail OAuth (for drafts/sending)
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_token

# Claude API (optional, for email personalization)
ANTHROPIC_API_KEY=your_key_here

# Sender Configuration
SENDER_EMAIL=hello@renewalweekly.com
SENDER_NAME=Rob

# Scraper Configuration
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_ISSUES=100
